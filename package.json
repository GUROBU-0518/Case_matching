{
  "name": "case-matching",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --pool=threads --no-file-parallelism --maxWorkers=1 --minWorkers=1",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "mail:mock": "node --experimental-strip-types src/mail/mock-cli.ts",
    "mail:preprocess": "node --experimental-strip-types src/mail/preprocess-cli.ts",
    "mail": "npm run mail:mock",
    "batch": "node --experimental-strip-types src/db/mail-batch-cli.ts",
    "batch:db": "node --experimental-strip-types src/db/mail-batch-cli.ts",
    "batch:memory": "node --experimental-strip-types src/batch/mail-batch-cli.ts",
    "graph:fetch": "node --env-file-if-exists=.env --experimental-strip-types src/mail/graph-mail-cli.ts",
    "graph:delta": "node --env-file-if-exists=.env --experimental-strip-types src/mail/graph-delta-cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^3.2.4"
  }
}
