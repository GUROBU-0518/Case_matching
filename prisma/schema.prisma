generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  // ID生成方式はSTEP3終了後に正式決定
  id                     String       @id
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  projectName            String?      @map("project_name") @db.VarChar(255)
  summary                String?
  // 情報なしはNULLではなく空配列で扱う
  requiredSkills         String[]     @map("required_skills")
  preferredSkills        String[]     @default([]) @map("preferred_skills")
  rate                   String?
  unitPriceMin           Int?         @map("unit_price_min")
  unitPriceMax           Int?         @map("unit_price_max")
  location               String?
  nearestStation         String?      @map("nearest_station")
  workStyle              String?      @map("work_style")
  startDate              String?      @map("start_date")
  headcount              Int?
  process                String?
  commercialRestrictions String?      @map("commercial_restrictions")
  sourceText             String?      @map("source_text")
  // 1メールから複数Projectが生成される可能性がある。メール以外から登録される可能性があるためNULL許可。
  mailMessageId          String?      @map("mail_message_id")
  mailMessage            MailMessage? @relation(fields: [mailMessageId], references: [id])
  // mailMessageIdの明示IndexはRelationによるIndexで十分かをSTEP5以降で確認する。

  @@map("projects")
}

model Talent {
  // ID生成方式はSTEP3終了後に正式決定
  id                String       @id
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  nameOrInitial     String?      @map("name_or_initial") @db.VarChar(100)
  // 情報なしはNULLではなく空配列で扱う
  technicalSkills   String[]     @map("technical_skills")
  desiredRate       String?      @map("desired_rate")
  desiredPriceMin   Int?         @map("desired_price_min")
  desiredPriceMax   Int?         @map("desired_price_max")
  nearestStation    String?      @map("nearest_station")
  desiredWorkStyle  String?      @map("desired_work_style")
  availableFrom     String?      @map("available_from")
  availablePeriod   String?      @map("available_period")
  age               String?
  yearsOfExperience String?      @map("years_of_experience")
  // 情報なしはNULLではなく空配列で扱う
  availableProcess  String[]     @map("available_process")
  // 所属はアプリケーション側でBP固定
  affiliation       String       @default("BP")
  affiliationType   String       @default("unknown") @map("affiliation_type") @db.VarChar(20)
  sourceText        String?      @map("source_text")
  notes             String?
  // 1メールから複数Talentが生成される可能性がある。メール以外から登録される可能性があるためNULL許可。
  mailMessageId     String?      @map("mail_message_id")
  mailMessage       MailMessage? @relation(fields: [mailMessageId], references: [id])
  // mailMessageIdの明示IndexはRelationによるIndexで十分かをSTEP5以降で確認する。

  @@map("talents")
}

model MailMessage {
  // ID生成方式はSTEP4以降で正式決定
  id             String        @id
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  graphMessageId String        @map("graph_message_id")
  mailboxId      String        @map("mailbox_id")
  folderId       String?       @map("folder_id")
  subject        String?       @db.VarChar(500)
  // 送信者識別用。画面表示しない。検索条件にしない。内部管理用途のみ。
  senderAddress  String?       @map("sender_address") @db.VarChar(320)
  // Graph上の受信日時
  receivedAt     DateTime?     @map("received_at") @db.Timestamptz(3)
  graphUpdatedAt DateTime?     @map("graph_updated_at") @db.Timestamptz(3)
  // Graphから取得した日時
  fetchedAt      DateTime      @map("fetched_at") @db.Timestamptz(3)
  sourceInfo     String?       @map("source_info")
  processedBody  String?       @map("processed_body")
  // onDeleteはSTEP5以降でCascade/Restrict/SetNull/NoActionを検討する。
  projects       Project[]
  talents        Talent[]
  aiProcessing   AiProcessing?

  // Graphメールの重複防止と複数メールボックス対応のため
  @@unique([mailboxId, graphMessageId])
  @@index([graphMessageId])
  @@index([mailboxId])
  @@index([receivedAt])
  @@map("mail_messages")
}

model AiProcessing {
  // ID生成方式はSTEP4以降で正式決定
  id                  String       @id
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  graphMessageId      String       @map("graph_message_id")
  // 将来的にmailMessageIdへ完全移行できる場合は削除候補
  status              String       @db.VarChar(30)
  startedAt           DateTime?    @map("started_at") @db.Timestamptz(3)
  endedAt             DateTime?    @map("ended_at") @db.Timestamptz(3)
  errorType           String?      @map("error_type") @db.VarChar(30)
  errorMessage        String?      @map("error_message")
  retryCount          Int          @default(0) @map("retry_count")
  lastRetriedAt       DateTime?    @map("last_retried_at") @db.Timestamptz(3)
  zodValidationStatus String?      @map("zod_validation_status")
  aiStatus            String?      @map("ai_status") @db.VarChar(30)
  classification      String?      @db.VarChar(10)
  // MVPでは1メール1処理。再処理はretryCount更新方式。
  mailMessageId       String?      @unique @map("mail_message_id")
  mailMessage         MailMessage? @relation(fields: [mailMessageId], references: [id])

  @@index([status])
  @@index([graphMessageId])
  @@map("ai_processings")
}

model BatchRun {
  // ID生成方式はSTEP4以降で正式決定
  id                 String    @id
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  startedAt          DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime? @map("ended_at") @db.Timestamptz(3)
  status             String    @db.VarChar(30)
  targetMailboxCount Int       @map("target_mailbox_count")
  targetCount        Int       @map("target_count")
  successCount       Int       @map("success_count")
  failureCount       Int       @map("failure_count")
  errorMessage       String?   @map("error_message")
  exitCode           Int?      @map("exit_code")

  @@map("batch_runs")
}

model MailSyncState {
  id           String   @id
  mailboxId    String   @unique @map("mailbox_id")
  deltaLink    String   @map("delta_link")
  lastSyncedAt DateTime @map("last_synced_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("mail_sync_states")
}
